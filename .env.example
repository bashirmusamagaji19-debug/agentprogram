# Copy to .env and fill in your API keys.
# .env is git-ignored — keys stay local.

DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key

# Streamlit Community Cloud: put these values in platform Secrets.
APP_PASSCODE=replace-with-a-private-access-code
APP_OWNER_ID=demo

# Omit all five values to use the local filesystem adapter.
DATABASE_URL=postgresql://user:password@db.example.com:5432/agent
OBJECT_STORAGE_ENDPOINT=https://objects.example.com
OBJECT_STORAGE_BUCKET=private-agent-artifacts
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
